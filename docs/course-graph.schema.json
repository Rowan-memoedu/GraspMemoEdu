{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GraspMemoEdu shared learning graph v1/v2/v3",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "subject_id", "course_id", "title", "nodes", "edges"],
  "properties": {
    "schema_version": {"enum": [1, 2, 3]},
    "subject_id": {"$ref": "#/$defs/id"},
    "course_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,127}$"},
    "title": {"$ref": "#/$defs/title"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {
      "type": "object", "additionalProperties": false, "required": ["title"],
      "oneOf": [
        {"required": ["topic_id"], "not": {"anyOf": [{"required": ["bank_id"]}, {"required": ["group_id"]}]}},
        {"required": ["bank_id", "group_id"], "not": {"required": ["topic_id"]}}
      ],
      "properties": {"topic_id": {"$ref": "#/$defs/id"}, "bank_id": {"$ref": "#/$defs/id"},
        "group_id": {"$ref": "#/$defs/id"}, "member": {"type": "boolean"},
        "title": {"$ref": "#/$defs/title"}, "source": {"$ref": "#/$defs/source"}}
    }},
    "edges": {"type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["from", "to", "type"],
      "properties": {"from": {"$ref": "#/$defs/nodeId"}, "to": {"$ref": "#/$defs/nodeId"}, "type": {"const": "prerequisite"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}, "source": {"$ref": "#/$defs/source"}}
    }}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": 1}}},
     "then": {"properties": {"nodes": {"items": {"required": ["topic_id"], "not": {"required": ["member"]}}}}},
     "else": {"properties": {"nodes": {"items": {"required": ["member"]}}}}},
    {"if": {"properties": {"schema_version": {"enum": [1, 2]}}},
     "then": {"properties": {
       "nodes": {"items": {"required": ["topic_id"]}},
       "edges": {"items": {"properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}}}}
     }}}
  ],
  "$defs": {
    "nodeId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "string", "pattern": "^group:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}:[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"}]},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "source": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
